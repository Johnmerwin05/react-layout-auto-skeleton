{
  "name": "react-layout-auto-skeleton",
  "version": "0.1.0",
  "description": "Automatic, layout-aware skeletons for React",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:lib && vite build",
    "build:lib": "tsup && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@eslint/js": "^9.15.0", "@testing-library/jest-dom": "^6.6.3", "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0", "eslint-plugin-react-hooks": "^5.1.0", "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1", "prettier": "^3.4.2", "react": "^19.0.0", "react-dom": "^19.0.0",
    "tsup": "^8.3.5", "typescript": "^5.7.2", "typescript-eslint": "^8.18.0", "vite": "^6.0.1", "vitest": "^2.1.8"
  }
}
